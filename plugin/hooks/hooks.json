{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:relay:relay",
            "tool": "relay_inbox",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "shows_open": "true"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:relay:relay",
            "tool": "relay_turn_end",
            "input": {
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}",
              "last_assistant_message": "${last_assistant_message}"
            }
          }
        ]
      }
    ]
  },
  "modules": [
    "./band.tsx"
  ]
}
